+/* ---- I2C driver ---- */
+static int ssd1306_probe(struct i2c_client *client,
+                         const struct i2c_device_id *id)
+{
+	(void)id;
+	struct ssd1306_dev *dev;
+	struct device *device;
+	int minor;
+	int ret;
+
+	/* Allocate minor number */
+	minor = ida_alloc(&ssd1306_ida, GFP_KERNEL);
+	if (minor < 0)
+		return minor;
+
+	/* Allocate driver data */
+	dev = devm_kzalloc(&client->dev, sizeof(*dev), GFP_KERNEL);
+	if (!dev) {
+		ret = -ENOMEM;
+		goto err_ida;
+	}
+
+	dev->client = client;
+	dev->devt = MKDEV(MAJOR(ssd1306_base_devt), minor);
+
+	mutex_init(&dev->lock);
+
+	i2c_set_clientdata(client, dev);
+
+	/* Initialize character device */
+	cdev_init(&dev->cdev, &ssd1306_fops);
+	dev->cdev.owner = THIS_MODULE;
+
+	ret = cdev_add(&dev->cdev, dev->devt, 1);
+	if (ret)
+		goto err_ida;
+
+	device = device_create(ssd1306_class, &client->dev, dev->devt, NULL, "ssd1306-%d", minor);
+	/* Create /dev node */
+	if (IS_ERR(device)) {
+		ret = PTR_ERR(device);
+		goto err_cdev;
+	}
+
+	/* Allocate framebuffer */
+	dev->framebuffer = devm_kzalloc(&client->dev, SSD1306_FB_SIZE, GFP_KERNEL);
+	if (!dev->framebuffer) {
+		ret = -ENOMEM;
+		goto err_device;
+	}
+
+	/* Initialize OLED */
+	ret = ssd1306_init_display(dev);
+	if (ret) {
+		dev_err(&client->dev, "Failed to initialize SSD1306 display\n");
+		goto err_device;
+	}
+	dev_info(&client->dev, "SSD1306 display initialized successfully\n");
+	ssd1306_clear_fb(dev);
+	dev_info(&client->dev, "SSD1306 display cleared successfully\n");
+	ssd1306_draw_pixel(dev, 0, 0, true);
+	ssd1306_draw_pixel(dev, 1, 1, true);
+	ssd1306_draw_pixel(dev, 2, 2, true);
+	
+	ssd1306_draw_pixel(dev, 8, 8, true);
+	ssd1306_draw_pixel(dev, 9, 9, true);
+	ssd1306_draw_pixel(dev, 10, 10, true);
+	
+	ssd1306_draw_pixel(dev, 16, 16, true);
+	ssd1306_draw_pixel(dev, 17, 17, true);
+	ssd1306_draw_pixel(dev, 18, 18, true);
+	
+	ssd1306_draw_pixel(dev, 24, 24, true);
+	ssd1306_draw_pixel(dev, 25, 25, true);
+	ssd1306_draw_pixel(dev, 26, 26, true);
+	
+	ssd1306_draw_pixel(dev, 32, 32, true);
+	ssd1306_draw_pixel(dev, 33, 33, true);
+	ssd1306_draw_pixel(dev, 34, 34, true);
+	
+	ssd1306_draw_pixel(dev, 40, 40, true);
+	ssd1306_draw_pixel(dev, 41, 41, true);
+	ssd1306_draw_pixel(dev, 42, 42, true);
+	ssd1306_refresh(dev);
+	ssd1306_draw_char(dev, 0, 0, 'A');
+	ssd1306_draw_char(dev, 0, 6, 'B');
+	ssd1306_draw_char(dev, 1, 0, 'C');
+	ssd1306_draw_char(dev, 1, 6, 'D');
+
+	ssd1306_draw_fast_hline(dev, 0, 50, 64, true);
+	ssd1306_draw_fast_vline(dev, 63, 45, 20, true);
+	ssd1306_draw_line(dev, 25, 25, 63, 63, true);
+	ssd1306_draw_rect(dev, 10, 10, 20, 20, true);
+	ssd1306_fill_rect(dev, 30, 10, 20, 20, true);
+	ssd1306_draw_triangle(dev, 100, 10, 90, 30, 110, 40, true);
+
+	ssd1306_clear_fb(dev);
+	ssd1306_draw_bitmap(dev,
+                    0,
+                    0,
+                    review,
+                    128,
+                    64,
+                    true);
+
+	// ssd1306_draw_string(dev, 2, 0, "Hello from Le Hong Son - FPT Automotive, SSD1306!");
+	ssd1306_refresh(dev);
+	dev_info(&client->dev, "SSD1306 display refreshed successfully\n");
+
+	dev_info(&client->dev, "SSD1306 probed (minor=%d)\n", minor);
+
+	return 0;
+
+err_device:
+	device_destroy(ssd1306_class, dev->devt);
+
+err_cdev:
+	cdev_del(&dev->cdev);
+
+err_ida:
+	ida_free(&ssd1306_ida, minor);
+
+	return ret;
+}
+
+static int ssd1306_remove(struct i2c_client *client)
+{
+	struct ssd1306_dev *dev = i2c_get_clientdata(client);
+
+	dev_info(&client->dev, "Removing SSD1306 display\n");
+	ssd1306_clear_fb(dev);
+	ssd1306_write_cmd(dev, 0xAE); /* Display OFF */
+
+	device_destroy(ssd1306_class, dev->devt);
+	cdev_del(&dev->cdev);
+	ida_free(&ssd1306_ida, MINOR(dev->devt));
+
+	dev_info(&client->dev, "SSD1306 removed\n");
+	return 0;
+}
+
+static const struct of_device_id ssd1306_of_match[] = {
+	{ .compatible = "training,ssd1306" },
+	{ }
+};
+
+static const struct i2c_device_id ssd1306_id[] = {
+	{ "training_ssd1306", 0 },
+	{ }
+};
+
+static struct i2c_driver ssd1306_driver = {
+	.driver = {
+		.name		= DEVICE_NAME,
+		.of_match_table	= ssd1306_of_match,
+	},
+	.probe		= ssd1306_probe,
+	.remove		= ssd1306_remove,
+	.id_table	= ssd1306_id,
+};
+
+static int __init ssd1306_init(void)
+{
+    int ret;
+
+	ret = alloc_chrdev_region(&ssd1306_base_devt, 0, SSD1306_MAX_DEVS, DEVICE_NAME);
+	if (ret < 0) {
+		pr_err("Failed to allocate char device region\n");
+		return ret;
+	}
+
+	// Dùng để đăng ký một lớp mới vào hệ thống. Lớp này sẽ xuất 
+	// hiện dưới dạng một thư mục tại đường dẫn /sys/class/ trong không gian người dùng. 
+	ssd1306_class = class_create(THIS_MODULE, "ssd1306");
+	if (IS_ERR(ssd1306_class)) {	
+		unregister_chrdev_region(ssd1306_base_devt, SSD1306_MAX_DEVS);
+		pr_err("Failed to create device class\n");
+		ret = PTR_ERR(ssd1306_class);
+		return ret;
+	}
+	
+	ret = i2c_add_driver(&ssd1306_driver);
+    if (ret) {
+        class_destroy(ssd1306_class);
+        unregister_chrdev_region(ssd1306_base_devt, SSD1306_MAX_DEVS);
+    }
+
+	return ret;
+}
+
+static void __exit ssd1306_exit(void)
+{
+	i2c_del_driver(&ssd1306_driver);
+	class_destroy(ssd1306_class);
+	unregister_chrdev_region(ssd1306_base_devt , SSD1306_MAX_DEVS);
+	ida_destroy(&ssd1306_ida);
+}
+
+// module_i2c_driver(ssd1306_driver);
+module_init(ssd1306_init);
+module_exit(ssd1306_exit);
+
+MODULE_DEVICE_TABLE(of, ssd1306_of_match);
+MODULE_DEVICE_TABLE(i2c, ssd1306_id);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Training");
+MODULE_DESCRIPTION("SSD1306 OLED I2C driver - display characters via /dev/ssd1306");
