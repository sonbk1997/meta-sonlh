+/*
+ * SSD1306 initialization sequence
+ * Reference: SSD1306 datasheet, section 3 (Command Table)
+ */
+static const u8 ssd1306_init_cmds[] = {
+	0xAE,		/* Display OFF */
+	0xD5, 0x80,	/* Set clock div ratio / oscillator freq */
+	0xA8, 0x3F,	/* Set multiplex ratio: 64 lines */
+	0xD3, 0x00,	/* Set display offset: none */
+	0x40,		/* Set display start line: 0 */
+	0x8D, 0x14,	/* Enable charge pump */
+	0x20, 0x02,	/* Memory addressing mode: page */
+	0xA1,		/* Segment re-map: col 127 = SEG0 */
+	0xC8,		/* COM scan direction: remapped */
+	0xDA, 0x12,	/* Set COM pins config: alternative */
+	0x81, 0xCF,	/* Set contrast: 0xCF */
+	0xD9, 0xF1,	/* Set pre-charge period */
+	0xDB, 0x40,	/* Set VCOMH deselect level */
+	0xA4,		/* Display from RAM */
+	0xA6,		/* Normal display (not inverted) */
+	0x2E,		/* Deactivate scroll */
+	0xAF,		/* Display ON */
+};
+
+static int ssd1306_init_display(struct ssd1306_dev *dev)
+{
+	int i, ret;
+	dev_info(&dev->client->dev, "Initializing SSD1306 display\n");
+
+	for (i = 0; i < ARRAY_SIZE(ssd1306_init_cmds); i++) {
+		ret = ssd1306_write_cmd(dev, ssd1306_init_cmds[i]);
+		if (ret < 0)
+			return ret;
+	}
+	dev_info(&dev->client->dev, "Finished initializing SSD1306 display\n");
+
+	ret = ssd1306_clear_fb(dev);
+	if (ret < 0)
+		return ret;
+
+	return ssd1306_refresh(dev);
+}
+
+/* ---- File operations ---- */
+static int ssd1306_fop_open(struct inode *inode, struct file *file)  {
+    struct ssd1306_dev *dev;
+
+    printk(KERN_INFO "ssd1306: Device opened %s\n", inode->i_cdev);
+    dev = container_of(inode->i_cdev, struct ssd1306_dev, cdev);
+    file->private_data = dev;
+
+    return 0;
+}
+
+static int ssd1306_fop_release(struct inode *inode, struct file *file)
+{
+    file->private_data = NULL;
+
+    return 0;
+}
+
+static ssize_t ssd1306_fop_read(struct file *file, char *buf, size_t count, loff_t *offset)
+{
+    struct ssd1306_dev *dev = file->private_data;
+
+    return -EINVAL;
+}
+
+static ssize_t ssd1306_fop_write(struct file *file,
+				 const char __user *buf,
+				 size_t count, loff_t *offset)
+{
+	struct ssd1306_dev *dev = file->private_data;
+	char *kbuf;
+	int ret;
+
+	kbuf = memdup_user_nul(buf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	pr_info("%s\n", kbuf);
+
+	mutex_lock(&dev->lock);
+
+	ret = ssd1306_clear_fb(dev);
+	if (ret < 0)
+		goto unlock;
+
+	ssd1306_draw_string(dev, 0, 0, kbuf);
+
+	ret = ssd1306_refresh(dev);
+
+unlock:
+	mutex_unlock(&dev->lock);
+
+	kfree(kbuf);
+
+	if (ret)
+		return ret;
+
+	return count;
+}
+
+static const struct file_operations ssd1306_fops = {
+	.owner	= THIS_MODULE,
+	.open	= ssd1306_fop_open,
+	.read	= ssd1306_fop_read,
+	.write	= ssd1306_fop_write,
+    .release = ssd1306_fop_release,
+};
