+
+struct ssd1306_dev {
+	struct i2c_client *client;
+	/* Character Device */
+	dev_t devt;				// -> major + minor: 32 bits including 20bit(minor) + 12bit(major) --> MAJOR(dev), MINOR(dev), và MKDEV(major, minor).
+	struct cdev cdev;		// -> struct cdev là cấu trúc dữ liệu cơ bản đại diện cho một thiết bị ký tự (character device)
+							// struct cdev nằm trong file header <linux/cdev.h> với các trường quan trọng: ops(file_operations), owner(module), kobj(kobject), dev(devid dev_t), list(list_head)
+	u8 cursor_page;
+	u8 cursor_col;
+	u8 txbuf[SSD1306_WIDTH + 1];	// -> buffer for I2C transfer, +1 for control byte	
+
+    u8 *framebuffer;
+	struct mutex lock;
+};
+
+static struct class *ssd1306_class;	// -> device class for sysfs /sys/class/ssd1306
+static dev_t ssd1306_base_devt;
+static DEFINE_IDA(ssd1306_ida);
+
+/* *********************************************************************************************
+-----------------Low-level I2C helpers for SSD1306----------------------------------------------
+***********************************************************************************************/
+
+/* ---- SSD1306 write data ---- */
+static int ssd1306_write_cmd(struct ssd1306_dev *dev, u8 cmd)
+{
+	int ret = 0;
+	u8 buf[2] = {SSD1306_CTRL_CMD, cmd};
+
+	ret = i2c_master_send(dev->client, buf, 2);
+	if(ret < 0) {
+		dev_err(&dev->client->dev, "Failed to write command 0x%02X to SSD1306: %d\n", cmd, ret);
+		return ret;
+	}
+	return ret;
+}
+
+/* ---- SSD1306 write data ---- */
+static int ssd1306_write_data(struct ssd1306_dev *dev, const u8 *data, int len)
+{
+	int ret = 0;
+
+	dev_info(&dev->client->dev, "Writing %d bytes of data to SSD1306\n", len);
+	dev->txbuf[0] = SSD1306_CTRL_DATA;
+	memcpy(dev->txbuf + 1, data, len);
+
+	ret = i2c_master_send(dev->client, dev->txbuf, len + 1);
+	if (ret < 0) {
+		return ret;
+	}
+	
+	return ret;
+}
+
+/* ---- SSD1306 display control ---- */
+/* Function ssd1306_draw_pixel: Draw a pixel at (x, y) with the specified color (true for white, false for black)
+@input: dev - pointer to the ssd1306_dev structure
+		x - x-coordinate of the pixel (0 to SSD1306_WIDTH-1)
+		y - y-coordinate of the pixel (0 to SSD1306_HEIGHT-1)
+		color - true for white pixel, false for black pixel
+** ****************************************************************************************************************/
+static int ssd1306_set_cursor(struct ssd1306_dev *dev, u8 page, u8 col)
+{
+	int ret;
+
+	/* Set page address */
+	ret = ssd1306_write_cmd(dev, 0xB0 | (page & 0x07));
+	if (ret < 0)
+		return ret;
+
+	/* Set column address low nibble */
+	ret = ssd1306_write_cmd(dev, col & 0x0F);
+	if (ret < 0)
+		return ret;
+
+	/* Set column address high nibble */
+	ret = ssd1306_write_cmd(dev, 0x10 | ((col >> 4) & 0x0F));
+	if (ret < 0)
+		return ret;
+
+	dev->cursor_page = page;
+	dev->cursor_col = col;
+	return 0;
+}
+
+static void ssd1306_draw_pixel(struct ssd1306_dev *dev, u8 x, u8 y, bool color)
+{
+	u16 offset;
+    u8 page;
+    u8 bit;
+
+    /* Boundary check */
+    if (x >= SSD1306_WIDTH || y >= SSD1306_HEIGHT)
+        return;
+
+    page = y / 8;
+    bit  = y % 8;
+
+    offset = page * SSD1306_WIDTH + x;
+
+    if (color)
+        dev->framebuffer[offset] |= BIT(bit);
+    else
+        dev->framebuffer[offset] &= ~BIT(bit);
+}
+
+/* Function ssd1306_draw_char: Draw a character at (page, col) with the specified color
+ * @input: dev - pointer to the ssd1306_dev structure
+ *         page - page number (0 to SSD1306_PAGES-1)
+ *         col - column number (0 to SSD1306_WIDTH-1)
+ *         c - character to draw
+ */
+static int ssd1306_draw_char(struct ssd1306_dev *dev, u8 page, u8 col, char c)
+{
+	const u8 *glyph;
+    u16 index;
+    int i;
+
+    /* Check page */
+    if (page >= SSD1306_PAGES)
+        return -EINVAL;
+
+    /* Need 5 pixels + 1 spacing pixel */
+    if (col > (SSD1306_WIDTH - FONT_WIDTH - 1))
+        return -EINVAL;
+
+	if (c == '\n') {
+		page++;
+		if (page >= SSD1306_PAGES)
+			page = 0;
+		col = 0;
+		return ssd1306_set_cursor(dev, page, col);
+	}
+
+    /* Unsupported character */
+    if (c < FONT_FIRST || c > FONT_LAST)
+        c = '?';
+
+    glyph = font5x8[c - FONT_FIRST];
+
+    index = page * SSD1306_WIDTH + col;
+
+    /* Copy font into framebuffer */
+    memcpy(&dev->framebuffer[index], glyph, FONT_WIDTH);
+
+    /* One blank column between characters */
+    dev->framebuffer[index + FONT_WIDTH] = 0x00;
+
+    return 0;
+}
+
+static int ssd1306_draw_string(struct ssd1306_dev *dev, u8 x, u8 y, const char *str)
+{
+	int ret;
+	u8 page = y / 8; /* y must align to page */
+	u8 col = x;
+	while (*str) {
+		ret = ssd1306_draw_char(dev, page, col, *str++);
+		if (ret < 0)
+			return ret;
+		col += FONT_WIDTH + 1; /* Move to next character position */
+		if (col > (SSD1306_WIDTH - FONT_WIDTH - 1)) {
+			/* Move to next page if current page is full */
+			col = 0;
+			page++;
+			if (page >= SSD1306_PAGES)
+				break; /* No more space on display */
+		}
+	}
+	return 0;
+}
+
+static int ssd1306_clear_fb(struct ssd1306_dev *dev)
+{
+	memset(dev->framebuffer, 0x00, SSD1306_FB_SIZE);
+	return 0;
+}
+
+static int ssd1306_refresh(struct ssd1306_dev *dev)
+{
+	int ret = 0;
+	int page;
+
+	for (page = 0; page < SSD1306_PAGES; page++) {
+		ret = ssd1306_set_cursor(dev, page, 0);
+		if(ret < 0)
+			return ret;
+		ret = ssd1306_write_data(dev, dev->framebuffer + page * SSD1306_WIDTH, SSD1306_WIDTH);
+		if(ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static void ssd1306_draw_fast_hline(struct ssd1306_dev *dev, u8 x, u8 y, u8 width, bool color)
+{
+	u8 page;
+	u8 mask;
+	u16 index;
+	u8 i;
+
+	if (!dev)
+		return;
+
+	if (y >= SSD1306_HEIGHT)
+		return;
+
+	if (x >= SSD1306_WIDTH)
+		return;
+
+	if ((u16)x + width > SSD1306_WIDTH)
+		width = SSD1306_WIDTH - x;
+
+	page = y >> 3;
+	mask = BIT(y & 0x07);
+
+	for (i = 0; i < width; i++) {
+		index = page * SSD1306_WIDTH + x + i;
+
+		if (color)
+			dev->framebuffer[index] |= mask;
+		else
+			dev->framebuffer[index] &= ~mask;
+	}
+}
+
+static void ssd1306_draw_fast_vline(struct ssd1306_dev *dev, u8 x, u8 y, u8 height, bool color)
+{
+	u8 page;
+	u8 mask;
+	u16 index;
+	u8 i;
+
+	if (!dev)
+		return;
+
+	if (y >= SSD1306_HEIGHT)
+		return;
+
+	if (x >= SSD1306_WIDTH)
+		return;
+
+	if ((u16)y + height > SSD1306_HEIGHT)
+		height = SSD1306_HEIGHT - y;
+
+	for (i = 0; i < height; i++) {
+		page = (y+i) >> 3;
+		index = page * SSD1306_WIDTH + x;
+
+		mask = BIT((y+i) & 0x07);
+		if (color)
+			dev->framebuffer[index] |= mask;
+		else
+			dev->framebuffer[index] &= ~mask;
+	}
+}
+
+static void ssd1306_draw_line(struct ssd1306_dev *dev,
+                              int x0, int y0,
+                              int x1, int y1,
+                              bool color)
+{
+	int dx, dy;
+	int sx, sy;
+	int err, e2;
+
+	if (!dev)
+		return;
+
+	/* Fast path: Horizontal line */
+	if (y0 == y1) {
+		if (x0 > x1)
+			swap(x0, x1);
+
+		ssd1306_draw_fast_hline(dev,
+					x0,
+					y0,
+					x1 - x0 + 1,
+					color);
+		return;
+	}
+
+	/* Fast path: Vertical line */
+	if (x0 == x1) {
+		if (y0 > y1)
+			swap(y0, y1);
+
+		ssd1306_draw_fast_vline(dev,
+					x0,
+					y0,
+					y1 - y0 + 1,
+					color);
+		return;
+	}
+
+	dx = abs(x1 - x0);
+	dy = abs(y1 - y0);
+
+	sx = (x0 < x1) ? 1 : -1;
+	sy = (y0 < y1) ? 1 : -1;
+
+	err = dx - dy;
+
+	while (true) {
+
+		ssd1306_draw_pixel(dev, x0, y0, color);
+
+		if (x0 == x1 && y0 == y1)
+			break;
+
+		e2 = err << 1;
+
+		if (e2 > -dy) {
+			err -= dy;
+			x0 += sx;
+		}
+
+		if (e2 < dx) {
+			err += dx;
+			y0 += sy;
+		}
+	}
+}
+
+static void ssd1306_draw_rect(struct ssd1306_dev *dev,
+			      u8 x,
+			      u8 y,
+			      u8 width,
+			      u8 height,
+			      bool color)
+{
+	if (!dev)
+		return;
+
+	if (!width || !height)
+		return;
+
+	/* Top */
+	ssd1306_draw_fast_hline(dev, x, y, width, color);
+
+	/* Bottom */
+	if (height > 1)
+		ssd1306_draw_fast_hline(dev,
+					x,
+					y + height - 1,
+					width,
+					color);
+
+	/* Left */
+	if (height > 2)
+		ssd1306_draw_fast_vline(dev,
+					x,
+					y + 1,
+					height - 2,
+					color);
+
+	/* Right */
+	if (width > 1 && height > 2)
+		ssd1306_draw_fast_vline(dev,
+					x + width - 1,
+					y + 1,
+					height - 2,
+					color);
+}
+
+static void ssd1306_fill_rect(struct ssd1306_dev *dev,
+			      u8 x,
+			      u8 y,
+			      u8 width,
+			      u8 height,
+			      bool color)
+{
+	u8 row;
+
+	if (!dev)
+		return;
+
+	if (!width || !height)
+		return;
+
+	for (row = 0; row < height; row++)
+		ssd1306_draw_fast_hline(dev,
+					x,
+					y + row,
+					width,
+					color);
+}
+
+static void ssd1306_draw_triangle(struct ssd1306_dev *dev,
+				  int x0, int y0,
+				  int x1, int y1,
+				  int x2, int y2,
+				  bool color)
+{
+	if (!dev)
+		return;
+
+	ssd1306_draw_line(dev, x0, y0, x1, y1, color);
+	ssd1306_draw_line(dev, x1, y1, x2, y2, color);
+	ssd1306_draw_line(dev, x2, y2, x0, y0, color);
+}
+
+static void ssd1306_draw_bitmap(struct ssd1306_dev *dev,
+			      u8 x, u8 y,
+			      const u8 *bitmap,
+			      u8 width, u8 height,
+			      bool color)
+{
+	u8 row, col;
+	u16 index;
+
+	if (!dev)
+		return;
+
+	if (!width || !height)
+		return;
+
+	for (row = 0; row < height; row++) {
+		for (col = 0; col < width; col++) {
+			index = row * width + col;
+			if (bitmap[index / 8] & BIT(7 - (index % 8)))
+				ssd1306_draw_pixel(dev, x + col, y + row, color);
+		}
+	}
+}
